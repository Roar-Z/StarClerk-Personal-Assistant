# ========= 通用 =========
APP_HOST=127.0.0.1
APP_PORT=8756
DATA_DIR=./data

# ========= 主模型（OpenAI 兼容协议）=========
# provider: doubao | kimi | qwen | deepseek | ollama | custom
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.5
LLM_TIMEOUT=60

# ========= 向量模型 =========
EMBED_PROVIDER=ollama
EMBED_BASE_URL=http://127.0.0.1:11434/v1
EMBED_API_KEY=ollama
EMBED_MODEL=bge-m3
EMBED_DIM=1024

# 云端不可用时自动降级到 Ollama
FALLBACK_ENABLED=true
FALLBACK_BASE_URL=http://127.0.0.1:11434/v1
FALLBACK_MODEL=qwen2.5:7b

# ========= Agent（ReAct）=========
AGENT_MAX_STEPS=3          # 最多思考几轮（含首轮）
AGENT_MEMORY_TOP_K=4       # 每轮思考前召回的记忆条数
WEB_SEARCH_ENABLED=true
TAVILY_API_KEY=            # 留空则用 DuckDuckGo HTML
WEB_SEARCH_TIMEOUT=12
PATROL_ALLOW_WEB=false     # 后台巡检默认不联网

# ========= 托管任务 / 套餐 =========
PLAN=free                  # free | pro（也可通过 PUT /api/config/plan 切换）
FREE_TASK_LIMIT=5          # 免费版最多 5 个托管任务
PRO_TASK_LIMIT=20
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL=20      # 调度子线程轮询间隔（秒）

# ========= 桌面 =========
HOTKEY=<ctrl>+<alt>+<space>
TRAY_ENABLED=true
WINDOW_MODE=webview   # webview | browser | none
